    "migrate": "tsc -p tsconfig.json && node dist/cli.js",
    "seed": "tsc -p tsconfig.json && node dist/seed.js"
  },
  "dependencies": { "pg": "^8.16.0" },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
