# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Make every secret with:  openssl rand -hex 32   (hex only: these go inside database URLs).

# --- Addresses (three DNS names pointing at the server's public IP) ---
APP_DOMAIN=app.example.ca
API_DOMAIN=api.example.ca
INGEST_DOMAIN=ingest.example.ca

# --- Secrets ---
POSTGRES_PASSWORD=change-me
APP_DB_PASSWORD=change-me
JWT_SECRET=change-me-at-least-32-characters-long
ENCRYPTION_KEY=change-me
INGEST_TOKEN=change-me

# --- Use a managed database instead of the bundled one: set both, and leave out --profile bundled-db ---
# DATABASE_URL=postgresql://admin:...@host:5432/routenorth
# APP_DATABASE_URL=postgresql://routenorth_app:<APP_DB_PASSWORD>@host:5432/routenorth

# --- Shown in the product and in legal pages ---
COMPANY_NAME=RouteNorth
PRIVACY_EMAIL=privacy@example.ca
SUPPORT_EMAIL=support@example.ca
GOVERNING_PROVINCE=Ontario

# --- Email (optional until you want invites and password resets to arrive) ---
RESEND_API_KEY=
EMAIL_FROM=
